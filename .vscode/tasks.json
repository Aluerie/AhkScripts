{
    // Ctrl+Shift+B: compile main.ahk into main.exe and restart it.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and restart main.exe",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\build.bat",
                "/nopause"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
